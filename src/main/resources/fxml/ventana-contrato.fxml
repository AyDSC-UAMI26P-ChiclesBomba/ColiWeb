<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
    Ventana de la HU-6: administración del contrato.

    Permite:
    1. Editar las cláusulas del contrato actual.
    2. Guardar las cláusulas del contrato actual.
    3. Guardar el texto como plantilla para contratos futuros.
    4. Generar el archivo PDF.
    5. Cancelar y cerrar la ventana.

    La firma física del contrato no se administra aquí.
-->
<VBox spacing="10"
      style="-fx-padding: 10px;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1">

    <Label text="Cláusulas del contrato"/>

    <TextArea
            fx:id="textAreaClausulas"
            prefHeight="300"
            wrapText="true"
            promptText="Escriba aquí las cláusulas del contrato"/>

    <HBox spacing="10">

        <Button
                text="Guardar contrato"
                onAction="#handleGuardar"/>

        <Button
                text="Guardar plantilla"
                onAction="#handleGuardarPlantilla"/>

        <Button
                text="Generar PDF"
                onAction="#handleGenerarPDF"/>

        <Button
                text="Cancelar"
                onAction="#handleCancelar"/>

    </HBox>

</VBox>
