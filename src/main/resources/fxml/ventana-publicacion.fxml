<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fitToWidth="true"
            prefHeight="720.0"
            prefWidth="900.0"
            style="-fx-background-color: #fcf6fc; -fx-background: #fcf6fc;">

    <VBox spacing="18.0"
          prefWidth="850.0"
          style="-fx-background-color: #fcf6fc; -fx-padding: 25;">

        <Label text="Publicación de Evento"
               textFill="#9d31e0">

            <font>
                <Font name="System Bold"
                      size="28.0"/>
            </font>

        </Label>

        <VBox spacing="12.0"
              style="-fx-background-color: #F2EBF2; -fx-background-radius: 15; -fx-padding: 20;">

            <Label text="Información del evento">

                <font>
                    <Font name="System Bold"
                          size="18.0"/>
                </font>

            </Label>

            <Label text="Puedes modificar los datos antes de realizar la publicación."
                   textFill="#666666"
                   wrapText="true"/>

            <GridPane hgap="15.0"
                      vgap="12.0">

                <Label text="Tipo de evento:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"/>

                <TextField fx:id="tipoEvento"
                           promptText="Ejemplo: Boda"
                           prefWidth="600.0"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"/>

                <Label text="Fecha:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"/>

                <DatePicker fx:id="fechaEvento"
                            promptText="Selecciona una fecha"
                            prefWidth="600.0"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="1"/>

                <Label text="Hora:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"/>

                <TextField fx:id="horaEvento"
                           promptText="Ejemplo: 18:30"
                           prefWidth="600.0"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="2"/>

                <Label text="Lugar:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="3"/>

                <TextField fx:id="lugarEvento"
                           promptText="Nombre del lugar"
                           prefWidth="600.0"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="3"/>

                <Label text="Dirección:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="4"/>

                <TextField fx:id="direccionEvento"
                           promptText="Dirección del evento"
                           prefWidth="600.0"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="4"/>

                <Label text="Detalles:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="5"/>

                <TextArea fx:id="detallesEvento"
                          promptText="Detalles adicionales del evento"
                          prefHeight="90.0"
                          prefWidth="600.0"
                          wrapText="true"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="5"/>

            </GridPane>

        </VBox>

        <VBox spacing="10.0">

            <HBox alignment="CENTER_LEFT"
                  spacing="12.0">

                <Label text="Fotografías del evento">

                    <font>
                        <Font name="System Bold"
                              size="18.0"/>
                    </font>

                </Label>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="agregarFotos"
                        mnemonicParsing="false"
                        onAction="#botonAgregarFotos"
                        text="Agregar fotografías"
                        style="-fx-background-color: #9d31e0;
                               -fx-text-fill: white;
                               -fx-background-radius: 30;
                               -fx-font-weight: bold;
                               -fx-padding: 8 18 8 18;"/>

            </HBox>

            <ScrollPane prefHeight="170.0"
                        fitToHeight="true"
                        fitToWidth="true"
                        hbarPolicy="AS_NEEDED"
                        vbarPolicy="NEVER"
                        style="-fx-background-color: transparent;
                               -fx-background: transparent;">

                <HBox fx:id="contenedorFotos"
                      alignment="CENTER_LEFT"
                      minHeight="140.0"
                      spacing="12.0"
                      style="-fx-background-color: #F2EBF2;
                             -fx-background-radius: 15;
                             -fx-padding: 12;">

                    <Label fx:id="mensajeSinFotos"
                           text="No hay fotografías seleccionadas."
                           textFill="#666666"/>

                </HBox>

            </ScrollPane>

        </VBox>

        <VBox spacing="10.0">

            <Label text="Mensaje de la publicación">

                <font>
                    <Font name="System Bold"
                          size="18.0"/>
                </font>

            </Label>

            <TextArea fx:id="mensajePublicacion"
                      prefHeight="150.0"
                      promptText="Escribe el mensaje que acompañará la publicación..."
                      wrapText="true"/>

        </VBox>

        <HBox spacing="15.0"
              alignment="CENTER_RIGHT">

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="verPublicaciones"
                    mnemonicParsing="false"
                    onAction="#botonVerPublicaciones"
                    text="Ver publicaciones"
                    style="-fx-background-color: #F2EBF2;
                           -fx-text-fill: #9d31e0;
                           -fx-background-radius: 30;
                           -fx-font-weight: bold;
                           -fx-padding: 8 22 8 22;
                           -fx-border-color: #9d31e0;
                           -fx-border-radius: 30;"/>

            <Button fx:id="cancelar"
                    mnemonicParsing="false"
                    onAction="#botonCancelar"
                    text="Cancelar"
                    style="-fx-background-color: #F2EBF2;
                           -fx-background-radius: 30;
                           -fx-font-weight: bold;
                           -fx-padding: 8 22 8 22;"/>

            <Button fx:id="publicar"
                    mnemonicParsing="false"
                    onAction="#botonPublicar"
                    text="Publicar"
                    style="-fx-background-color: #9d31e0;
                           -fx-text-fill: white;
                           -fx-background-radius: 30;
                           -fx-font-weight: bold;
                           -fx-padding: 8 22 8 22;"/>

        </HBox>

    </VBox>

</ScrollPane>